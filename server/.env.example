# Server Production Environment Variables
NODE_ENV=production
PORT=5000

# MongoDB Atlas Connection String
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://smartprice_user:SuperSecretPassword123@cluster0.abcde.mongodb.net/smartprice?retryWrites=true&w=majority

# JSON Web Token Secret & Expiration
JWT_SECRET=production_super_secure_jwt_secret_token_change_in_prod_2026
JWT_EXPIRES_IN=7d

# Allowed Frontend Client URL for CORS
CLIENT_URL=https://smartprice.vercel.app

# Optional Google Gemini API Key for enhanced LLM parsing
GEMINI_API_KEY=
